# ── LLM Provider (choose one) ─────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── LLM Configuration ─────────────────────────────────────────────────────────
LLM_PROVIDER=gemini                   # openai | gemini | anthropic
LLM_MODEL=gemini-1.5-flash          # model name for chosen provider

# ── Embedding Model ───────────────────────────────────────────────────────────
EMBEDDING_PROVIDER=fastembed             #  local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ── Part A — Ingestion & Parsing ──────────────────────────────────────────────
MAX_RETRIES=3                         # max parse attempts per file
TRACKER_DB_PATH=./data/parse_jobs.db
CHUNKS_OUTPUT_DIR=./data/chunks

# ── Chunking ──────────────────────────────────────────────────────────────────
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
TABLE_CONTEXT_TOKENS=50

# ── Part B — Vector Store ─────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=rfp_chunks

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=./logs
